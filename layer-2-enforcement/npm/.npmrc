# Назначение: направить npm на внутренний реестр.
# Статус: ПРОВЕРЕНО (npm 9+/10, ключи registry и always-auth); значение и умолчание
#         replace-registry-host — проверить на вашей версии командами ниже.
# Версии инструментов: npm 9+ / 10.x.
# Пункты CHECKLIST.md: 8, 9, 18.
#
# Проверка:
#   npm config get replace-registry-host
#   npm help config
#   npm view express --registry={{NPM_REGISTRY_URL}} --loglevel=http
# Ожидаем: в свежесобранном lock resolved-URL указывает на {{NPM_REGISTRY_URL}}.
# Если в существующем lock остался публичный хост, смена registry на живом локе
# ничего не меняет — лок пересобирается (пункт 9).

registry={{NPM_REGISTRY_URL}}
replace-registry-host=always
always-auth=true

# ignore-scripts=true ломает esbuild, sharp, node-gyp — это trade-off, не победа.
# Включать только после проверки конкретных пакетов вашего стека.
# ignore-scripts=true
